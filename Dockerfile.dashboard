FROM python:3.12-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update -qq && \
    apt-get install -y -qq --no-install-recommends \
    curl && \
    rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application
COPY . .

# Create data directories
RUN mkdir -p data/models data/metrics

# Expose port
EXPOSE 8501

# Start Streamlit dashboard
HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD curl -f http://localhost:${DASHBOARD_PORT:-8501}/ || exit 1

CMD ["sh", "-c", "streamlit run src/dashboard/app.py --server.port ${DASHBOARD_PORT:-8501} --server.address 0.0.0.0 --server.headless true --browser.gatherUsageStats false"]
