# SH-PDOPS Configuration
APP_NAME=SH-PDOPS
APP_VERSION=1.0.0
DEBUG=true

# Run mode: simulation | live | hybrid
RUN_MODE=simulation
HEALER_MODE=semi_auto

# Collector
COLLECTION_INTERVAL_SECONDS=15
METRICS_RETENTION_HOURS=24

# Detector
ANOMALY_SENSITIVITY=2.5
DETECTION_WINDOW_MINUTES=5

# Predictor
PREDICTION_HORIZON_MINUTES=30
FAILURE_PROBABILITY_THRESHOLD=0.7

# Healer
AUTO_HEAL_LOW_RISK=true
REQUIRE_APPROVAL_HIGH_RISK=true

# API
API_HOST=0.0.0.0
API_PORT=8000

# Dashboard
DASHBOARD_PORT=8501

# Optional: Production monitoring sources
# PROMETHEUS_URL=http://localhost:9090
